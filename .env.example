# Documentation only: no dotenv dependency/automatic loading. Export in your shell.
# Use an account token scoped to Workers AI inference/model discovery only.
AI_GEOPOLITIC_CLOUDFLARE_ACCOUNT_ID=
AI_GEOPOLITIC_CLOUDFLARE_API_TOKEN=
# Set these ONLY after verifying the account is Workers Free, with no paid path.
AI_GEOPOLITIC_CLOUDFLARE_PLAN=
AI_GEOPOLITIC_CLOUDFLARE_FREE_ALLOCATION_ONLY=
# Optional. Missing key uses the official public anonymous key, with lower priority.
AI_GEOPOLITIC_HORDE_API_KEY=
